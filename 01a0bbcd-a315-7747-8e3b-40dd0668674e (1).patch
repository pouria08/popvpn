+"""
+POPVPN — تست واقعی زنده بودن سرورها.
+
+این ماژول برای هر کانفیگ یک اتصال TCP واقعی برقرار می‌کند و
+تأخیر (latency) را اندازه می‌گیرد. کانفیگ‌هایی که پاسخ ندهند
+حذف می‌شوند و بقیه از سریع‌ترین به کندترین مرتب می‌شوند.
+
+نکته مهم درباره‌ی محدودیت این تست:
+
+    یک اتصال موفق TCP فقط ثابت می‌کند که «سرور در آن پورت
+    در دسترس است»، نه اینکه «پروکسی با کلید شما کار می‌کند».
+    برای کانفیگ‌هایی که پشت CDN (مثل Cloudflare) هستند، پورت
+    ۴۴۳ همیشه باز است حتی اگر خود Worker از کار افتاده باشد.
+
+    بنابراین این مرحله سرورهای «قطعاً مرده» را حذف می‌کند که
+    بخش بزرگی از کانفیگ‌های بی‌کیفیت را می‌گیرد، اما تضمین
+    صددرصدی کارکرد نیست. تست کامل نیازمند اجرای Xray/sing-box
+    و عبور دادن ترافیک واقعی است.
+
+فقط از کتابخانه استاندارد استفاده می‌شود تا وابستگی جدیدی به
+پروژه اضافه نشود.
+"""
+
+import concurrent.futures
+import os
+import socket
+import ssl
+import time
+
+import converters
+
+
+# ============================================================
+# CONFIGURATION
+# ============================================================
+
+# مهلت هر اتصال TCP (ثانیه)
+DEFAULT_TIMEOUT = 3.0
+
+# تعداد اتصال هم‌زمان.
+# مقدار بالا سرعت را زیاد می‌کند ولی روی Runner ضعیف باعث
+# خطای کاذب می‌شود؛ ۱۰۰ نقطه‌ی تعادل خوبی است.
+DEFAULT_WORKERS = 100
+
+# سقف تعداد کانفیگ‌هایی که تست می‌شوند.
+# صفر یعنی بدون محدودیت.
+DEFAULT_MAX_TEST = 0
+
+# اگر کمتر از این نسبت از کانفیگ‌ها زنده تشخیص داده شوند،
+# نتیجه مشکوک است (مثلاً شبکه‌ی Runner مسدود شده) و تست
+# نادیده گرفته می‌شود تا Subscription خالی منتشر نشود.
+MIN_SURVIVAL_RATIO = 0.05
+
+# آیا علاوه بر TCP، دست‌دادن TLS هم انجام شود؟
+#
+# پیش‌فرض خاموش است و این یک انتخاب عمدی است:
+# بعضی سرورهای سالم (مخصوصاً پشت CDN یا با پیکربندی‌های
+# غیرمعمول) دست‌دادن TLS استاندارد را کامل نمی‌کنند و روشن
+# بودن این گزینه باعث حذف اشتباهِ کانفیگ‌های سالم می‌شود.
+#
+# با POPVPN_TEST_TLS=1 می‌توان آن را فعال کرد تا تست
+# سخت‌گیرانه‌تر شود.
+DEFAULT_TLS_PROBE = False
+
+
+def tls_probe_enabled():
+    """
+    Whether the stricter TLS handshake probe is enabled.
+    """
+
+    value = os.environ.get(
+        "POPVPN_TEST_TLS",
+        "1" if DEFAULT_TLS_PROBE else "0"
+    ).strip().lower()
+
+    return value in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    )
+
+
+def _env_int(name, default):
+    """
+    Read an integer setting from the environment.
+    """
+
+    try:
+
+        value = os.environ.get(name, "").strip()
+
+        if not value:
+            return default
+
+        return int(value)
+
+    except Exception:
+
+        return default
+
+
+def _env_float(name, default):
+    """
+    Read a float setting from the environment.
+    """
+
+    try:
+
+        value = os.environ.get(name, "").strip()
+
+        if not value:
+            return default
+
+        return float(value)
+
+    except Exception:
+
+        return default
+
+
+def is_enabled():
+    """
+    Whether liveness testing should run.
+
+    Disabled by setting POPVPN_TEST=0, which keeps local runs
+    fast when you only want to regenerate the output files.
+    """
+
+    value = os.environ.get(
+        "POPVPN_TEST",
+        "1"
+    ).strip().lower()
+
+    return value not in (
+        "0",
+        "false",
+        "no",
+        "off",
+    )
+
+
+# ============================================================
+# DNS CACHE
+# ============================================================
+
+_dns_cache = {}
+
+
+def resolve_host(host):
+    """
+    Resolve a hostname to an IP address, with caching.
+
+    Many configs share the same domain, so caching avoids
+    hundreds of duplicate DNS lookups.
+    """
+
+    if not host:
+        return None
+
+    if host in _dns_cache:
+        return _dns_cache[host]
+
+    try:
+
+        info = socket.getaddrinfo(
+            host,
+            None,
+            socket.AF_UNSPEC,
+            socket.SOCK_STREAM
+        )
+
+        address = info[0][4][0]
+
+    except Exception:
+
+        address = None
+
+    _dns_cache[host] = address
+
+    return address
+
+
+# ============================================================
+# TCP / TLS PROBE
+# ============================================================
+
+def probe_endpoint(
+    host,
+    port,
+    timeout,
+    tls=False,
+    server_name=""
+):
+    """
+    Open a real connection and measure the latency.
+
+    Returns the round trip time in milliseconds, or None when
+    the endpoint does not answer.
+
+    When tls is true a TLS handshake is attempted as well,
+    which is a stronger signal than a bare TCP connect: a
+    server that accepts TCP but cannot complete a handshake
+    is almost certainly not a working proxy endpoint.
+    Certificate validation is intentionally disabled because
+    these servers legitimately use fake SNI values.
+    """
+
+    address = resolve_host(host)
+
+    if not address:
+        return None
+
+    try:
+
+        family = (
+            socket.AF_INET6
+            if ":" in address
+            else socket.AF_INET
+        )
+
+        start = time.monotonic()
+
+        sock = socket.socket(
+            family,
+            socket.SOCK_STREAM
+        )
+
+        sock.settimeout(timeout)
+
+        try:
+
+            sock.connect(
+                (address, port)
+            )
+
+            if tls:
+
+                context = ssl.create_default_context()
+
+                context.check_hostname = False
+                context.verify_mode = ssl.CERT_NONE
+
+                # A fake SNI is normal here, so failures to
+                # validate are expected and ignored.
+                wrapped = context.wrap_socket(
+                    sock,
+                    server_hostname=(
+                        server_name or None
+                    )
+                )
+
+                wrapped.close()
+
+                sock = None
+
+            elapsed = time.monotonic() - start
+
+            return int(elapsed * 1000)
+
+        finally:
+
+            if sock is not None:
+
+                try:
+
+                    sock.close()
+
+                except Exception:
+
+                    pass
+
+    except Exception:
+
+        return None
+
+
+# ============================================================
+# CONFIG TESTING
+# ============================================================
+
+def endpoint_of(config):
+    """
+    Extract the testable endpoint from a config.
+
+    Returns a tuple of (host, port, tls, server_name), or
+    None when the config cannot be parsed.
+    """
+
+    node = converters.parse_config(
+        config
+    )
+
+    if not node:
+        return None
+
+    host = node.get("server")
+    port = node.get("port")
+
+    if not host or not port:
+        return None
+
+    security = node.get("security", "none")
+
+    tls = (
+        security in ("tls", "reality")
+        and tls_probe_enabled()
+    )
+
+    server_name = (
+        node.get("sni")
+        or node.get("host")
+        or ""
+    )
+
+    return (
+        host,
+        int(port),
+        tls,
+        server_name
+    )
+
+
+def test_configs(
+    configs,
+    timeout=None,
+    workers=None,
+    max_test=None
+):
+    """
+    Test every config and return the ones that answered.
+
+    The result is a list of (config, latency_ms) sorted from
+    fastest to slowest.
+
+    Configs pointing at the same host and port are probed only
+    once and share the result, which cuts the work
+    dramatically because sources publish the same server under
+    many different names.
+    """
+
+    if timeout is None:
+
+        timeout = _env_float(
+            "POPVPN_TEST_TIMEOUT",
+            DEFAULT_TIMEOUT
+        )
+
+    if workers is None:
+
+        workers = _env_int(
+            "POPVPN_TEST_WORKERS",
+            DEFAULT_WORKERS
+        )
+
+    if max_test is None:
+
+        max_test = _env_int(
+            "POPVPN_TEST_MAX",
+            DEFAULT_MAX_TEST
+        )
+
+    if max_test and len(configs) > max_test:
+
+        print(
+            f"محدود شده به {max_test} کانفیگ برای تست."
+        )
+
+        configs = configs[:max_test]
+
+    # --------------------------------------------------------
+    # Group configs by endpoint.
+    # --------------------------------------------------------
+
+    endpoints = {}
+
+    unparsed = []
+
+    for config in configs:
+
+        endpoint = endpoint_of(config)
+
+        if not endpoint:
+
+            unparsed.append(config)
+
+            continue
+
+        endpoints.setdefault(
+            endpoint,
+            []
+        ).append(config)
+
+    print(
+        f"تست {len(configs)} کانفیگ "
+        f"روی {len(endpoints)} سرور یکتا..."
+    )
+
+    if not endpoints:
+
+        return (
+            [],
+            unparsed
+        )
+
+    # --------------------------------------------------------
+    # Probe every unique endpoint in parallel.
+    # --------------------------------------------------------
+
+    results = {}
+
+    started = time.monotonic()
+
+    with concurrent.futures.ThreadPoolExecutor(
+        max_workers=min(
+            workers,
+            len(endpoints)
+        )
+    ) as executor:
+
+        futures = {
+            executor.submit(
+                probe_endpoint,
+                host,
+                port,
+                timeout,
+                tls,
+                server_name
+            ): (host, port, tls, server_name)
+            for (
+                host,
+                port,
+                tls,
+                server_name
+            ) in endpoints
+        }
+
+        for future in concurrent.futures.as_completed(
+            futures
+        ):
+
+            endpoint = futures[future]
+
+            try:
+
+                latency = future.result()
+
+            except Exception:
+
+                latency = None
+
+            if latency is not None:
+
+                results[endpoint] = latency
+
+    duration = time.monotonic() - started
+
+    # --------------------------------------------------------
+    # Collect the configs whose endpoint answered.
+    # --------------------------------------------------------
+
+    alive = []
+
+    for endpoint, group in endpoints.items():
+
+        latency = results.get(endpoint)
+
+        if latency is None:
+            continue
+
+        for config in group:
+
+            alive.append(
+                (config, latency)
+            )
+
+    alive.sort(
+        key=lambda item: item[1]
+    )
+
+    print(
+        f"زنده: {len(alive)} از {len(configs)} "
+        f"در {duration:.1f} ثانیه"
+    )
+
+    if results:
+
+        fastest = min(results.values())
+        slowest = max(results.values())
+
+        print(
+            f"سریع‌ترین: {fastest}ms | "
+            f"کندترین: {slowest}ms"
+        )
+
+    return (
+        alive,
+        unparsed
+    )
+
+
+def filter_alive(configs):
+    """
+    Test configs and return only the live ones, fastest first.
+
+    Returns a tuple of (ordered_configs, latency_by_config).
+
+    Includes a safety net: when the survival ratio is
+    implausibly low the network of the runner is probably
+    blocked, so the original list is returned untouched rather
+    than publishing an almost empty subscription.
+    """
+
+    if not configs:
+
+        return (
+            configs,
+            {}
+        )
+
+    if not is_enabled():
+
+        print(
+            "تست اتصال غیرفعال است (POPVPN_TEST=0)."
+        )
+
+        return (
+            configs,
+            {}
+        )
+
+    alive, unparsed = test_configs(
+        configs
+    )
+
+    ratio = (
+        len(alive) / len(configs)
+        if configs
+        else 0
+    )
+
+    if ratio < MIN_SURVIVAL_RATIO:
+
+        print()
+        print(
+            "هشدار: نسبت سرورهای زنده غیرعادی پایین است "
+            f"({ratio:.1%})."
+        )
+
+        print(
+            "احتمالاً شبکه‌ی اجراکننده مسدود است؛ "
+            "نتیجه‌ی تست نادیده گرفته شد."
+        )
+
+        return (
+            configs,
+            {}
+        )
+
+    ordered = [
+        config
+        for config, _ in alive
+    ]
+
+    latencies = {
+        config: latency
+        for config, latency in alive
+    }
+
+    # Configs that could not be parsed are kept at the end so
+    # that an unusual but valid format is never silently lost.
+    ordered.extend(unparsed)
+
+    return (
+        ordered,
+        latencies
+    )
+
+
+def latency_map(configs):
+    """
+    Return a mapping of config -> latency in milliseconds.
+
+    Used to annotate node names with their measured speed.
+    """
+
+    alive, _ = test_configs(
+        configs
+    )
+
+    return {
+        config: latency
+        for config, latency in alive
+    }
