+"""
+POPVPN — تبدیل کانفیگ به فرمت کلاینت‌های مختلف.
+
+این ماژول URI های VLESS / VMess / Trojan / Shadowsocks را به یک
+ساختار داده‌ی نرمال تبدیل می‌کند و سپس خروجی‌های زیر را می‌سازد:
+
+    - Clash Meta (Mihomo)  -> YAML
+    - Sing-box / Hiddify   -> JSON
+
+هدف این است که main.py فقط Pipeline را مدیریت کند و منطق
+تبدیل فرمت‌ها اینجا و قابل تست جدا باقی بماند.
+"""
+
+import base64
+import json
+import re
+import urllib.parse
+
+
+# ============================================================
+# BASE64 HELPER
+# ============================================================
+
+def _b64_decode(payload):
+    """
+    Decode Base64 tolerating missing padding and both the
+    standard and URL-safe alphabets.
+    """
+
+    if not payload:
+        return None
+
+    compact = re.sub(
+        r"\s+",
+        "",
+        payload
+    )
+
+    compact += "=" * ((-len(compact)) % 4)
+
+    for decoder in (
+        base64.b64decode,
+        base64.urlsafe_b64decode,
+    ):
+
+        try:
+
+            return decoder(
+                compact
+            ).decode(
+                "utf-8",
+                errors="ignore"
+            )
+
+        except Exception:
+
+            continue
+
+    return None
+
+
+def _first(query, *keys, default=""):
+    """
+    Return the first present value among several query keys.
+
+    Sources are inconsistent (sni vs peer, pbk vs publicKey),
+    so every field is looked up under all known aliases.
+    """
+
+    for key in keys:
+
+        values = query.get(key)
+
+        if values:
+
+            value = values[0].strip()
+
+            if value:
+                return value
+
+    return default
+
+
+def _is_true(value):
+
+    return str(value).strip().lower() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    )
+
+
+# ============================================================
+# NETWORK / TRANSPORT
+# ============================================================
+
+def _normalize_network(value):
+    """
+    Map the many spellings of a transport to a canonical name.
+    """
+
+    network = (value or "tcp").strip().lower()
+
+    aliases = {
+        "": "tcp",
+        "raw": "tcp",
+        "none": "tcp",
+        "h2": "http",
+        "h3": "http",
+        "xhttp": "http",
+        "splithttp": "http",
+    }
+
+    return aliases.get(
+        network,
+        network
+    )
+
+
+# ============================================================
+# PARSERS
+# ============================================================
+
+def parse_vless(uri):
+    """
+    Parse a vless:// URI.
+    """
+
+    parsed = urllib.parse.urlparse(uri)
+
+    if not parsed.hostname or not parsed.port:
+        return None
+
+    query = urllib.parse.parse_qs(
+        parsed.query
+    )
+
+    security = _first(
+        query,
+        "security",
+        default="none"
+    ).lower()
+
+    node = {
+        "protocol": "vless",
+        "server": parsed.hostname,
+        "port": int(parsed.port),
+        "uuid": urllib.parse.unquote(
+            parsed.username or ""
+        ),
+        "network": _normalize_network(
+            _first(query, "type", "headerType")
+        ),
+        "security": security,
+        "sni": _first(
+            query,
+            "sni",
+            "peer",
+            "host"
+        ),
+        "host": _first(query, "host"),
+        "path": urllib.parse.unquote(
+            _first(query, "path", default="/")
+        ),
+        "flow": _first(query, "flow"),
+        "fingerprint": _first(
+            query,
+            "fp",
+            default="chrome"
+        ),
+        "public_key": _first(
+            query,
+            "pbk",
+            "publicKey"
+        ),
+        "short_id": _first(
+            query,
+            "sid",
+            "shortId"
+        ),
+        "service_name": _first(
+            query,
+            "serviceName",
+            "servicename"
+        ),
+        "alpn": _first(query, "alpn"),
+        "insecure": _is_true(
+            _first(
+                query,
+                "allowInsecure",
+                "insecure",
+                default="0"
+            )
+        ),
+    }
+
+    if not node["uuid"]:
+        return None
+
+    return node
+
+
+def parse_vmess(uri):
+    """
+    Parse a vmess:// config.
+
+    Handles both the Base64 JSON body and the newer
+    uuid@host:port URI form.
+    """
+
+    body = uri[len("vmess://"):].strip()
+
+    if not body:
+        return None
+
+    # ----------------------------------------------------
+    # URI form
+    # ----------------------------------------------------
+
+    if "@" in body.split("?", 1)[0]:
+
+        parsed = urllib.parse.urlparse(uri)
+
+        if not parsed.hostname or not parsed.port:
+            return None
+
+        query = urllib.parse.parse_qs(
+            parsed.query
+        )
+
+        return {
+            "protocol": "vmess",
+            "server": parsed.hostname,
+            "port": int(parsed.port),
+            "uuid": urllib.parse.unquote(
+                parsed.username or ""
+            ),
+            "alter_id": 0,
+            "cipher": _first(
+                query,
+                "encryption",
+                default="auto"
+            ),
+            "network": _normalize_network(
+                _first(query, "type")
+            ),
+            "security": _first(
+                query,
+                "security",
+                default="none"
+            ).lower(),
+            "sni": _first(query, "sni", "host"),
+            "host": _first(query, "host"),
+            "path": urllib.parse.unquote(
+                _first(query, "path", default="/")
+            ),
+            "fingerprint": _first(query, "fp"),
+            "alpn": _first(query, "alpn"),
+            "insecure": False,
+            "service_name": "",
+        }
+
+    # ----------------------------------------------------
+    # Base64 JSON form
+    # ----------------------------------------------------
+
+    decoded = _b64_decode(
+        body.split("#", 1)[0]
+    )
+
+    if not decoded:
+        return None
+
+    try:
+
+        data = json.loads(decoded)
+
+    except Exception:
+
+        return None
+
+    if not isinstance(data, dict):
+        return None
+
+    server = str(
+        data.get("add", "")
+    ).strip()
+
+    uuid = str(
+        data.get("id", "")
+    ).strip()
+
+    port_raw = str(
+        data.get("port", "")
+    ).strip()
+
+    if not server or not uuid or not port_raw:
+        return None
+
+    try:
+
+        port = int(port_raw)
+
+    except Exception:
+
+        return None
+
+    tls_field = str(
+        data.get("tls", "")
+    ).strip().lower()
+
+    try:
+
+        alter_id = int(
+            str(
+                data.get("aid", 0)
+            ).strip() or 0
+        )
+
+    except Exception:
+
+        alter_id = 0
+
+    return {
+        "protocol": "vmess",
+        "server": server,
+        "port": port,
+        "uuid": uuid,
+        "alter_id": alter_id,
+        "cipher": str(
+            data.get("scy", "auto")
+        ).strip() or "auto",
+        "network": _normalize_network(
+            str(data.get("net", "tcp"))
+        ),
+        "security": "tls" if tls_field == "tls" else "none",
+        "sni": str(
+            data.get("sni", "")
+        ).strip(),
+        "host": str(
+            data.get("host", "")
+        ).strip(),
+        "path": str(
+            data.get("path", "/")
+        ).strip() or "/",
+        "fingerprint": str(
+            data.get("fp", "")
+        ).strip(),
+        "alpn": str(
+            data.get("alpn", "")
+        ).strip(),
+        "insecure": bool(
+            data.get("skip-cert-verify", False)
+        ),
+        "service_name": str(
+            data.get("path", "")
+        ).strip(),
+        "name": str(
+            data.get("ps", "")
+        ).strip(),
+    }
+
+
+def parse_trojan(uri):
+    """
+    Parse a trojan:// URI.
+    """
+
+    parsed = urllib.parse.urlparse(uri)
+
+    if not parsed.hostname or not parsed.port:
+        return None
+
+    password = urllib.parse.unquote(
+        parsed.username or ""
+    )
+
+    if not password:
+        return None
+
+    query = urllib.parse.parse_qs(
+        parsed.query
+    )
+
+    return {
+        "protocol": "trojan",
+        "server": parsed.hostname,
+        "port": int(parsed.port),
+        "password": password,
+        "network": _normalize_network(
+            _first(query, "type", "headerType")
+        ),
+        "security": _first(
+            query,
+            "security",
+            default="tls"
+        ).lower(),
+        "sni": _first(
+            query,
+            "sni",
+            "peer",
+            "host"
+        ),
+        "host": _first(query, "host"),
+        "path": urllib.parse.unquote(
+            _first(query, "path", default="/")
+        ),
+        "fingerprint": _first(query, "fp"),
+        "public_key": _first(query, "pbk"),
+        "short_id": _first(query, "sid"),
+        "service_name": _first(
+            query,
+            "serviceName",
+            "servicename"
+        ),
+        "alpn": _first(query, "alpn"),
+        "insecure": _is_true(
+            _first(
+                query,
+                "allowInsecure",
+                "insecure",
+                default="0"
+            )
+        ),
+    }
+
+
+def parse_shadowsocks(uri):
+    """
+    Parse an ss:// or shadowsocks:// URI.
+
+    Supported shapes:
+        ss://base64(method:pass)@host:port
+        ss://method:pass@host:port
+        ss://base64(method:pass@host:port)
+    """
+
+    body = uri.split("://", 1)[1]
+
+    body = body.split("#", 1)[0]
+
+    plugin_part = ""
+
+    if "?" in body:
+
+        body, plugin_part = body.split("?", 1)
+
+    method = ""
+    password = ""
+    host = ""
+    port = 0
+
+    if "@" in body:
+
+        userinfo, hostport = body.rsplit("@", 1)
+
+        decoded = _b64_decode(userinfo)
+
+        if decoded and ":" in decoded:
+
+            method, password = decoded.split(":", 1)
+
+        elif ":" in userinfo:
+
+            method, password = urllib.parse.unquote(
+                userinfo
+            ).split(":", 1)
+
+        else:
+
+            return None
+
+        if ":" not in hostport:
+            return None
+
+        host, port_raw = hostport.rsplit(":", 1)
+
+    else:
+
+        decoded = _b64_decode(body)
+
+        if not decoded or "@" not in decoded:
+            return None
+
+        userinfo, hostport = decoded.rsplit("@", 1)
+
+        if ":" not in userinfo or ":" not in hostport:
+            return None
+
+        method, password = userinfo.split(":", 1)
+
+        host, port_raw = hostport.rsplit(":", 1)
+
+    host = host.strip("[]")
+
+    try:
+
+        port = int(port_raw)
+
+    except Exception:
+
+        return None
+
+    if not method or not host or not port:
+        return None
+
+    # Plugins such as obfs are not representable in every
+    # client, so they are recorded but not expanded.
+    plugin = ""
+
+    if plugin_part:
+
+        query = urllib.parse.parse_qs(plugin_part)
+
+        plugin = _first(query, "plugin")
+
+    return {
+        "protocol": "shadowsocks",
+        "server": host,
+        "port": port,
+        "method": method.strip(),
+        "password": password,
+        "plugin": plugin,
+    }
+
+
+def parse_config(uri):
+    """
+    Parse any supported config URI into a normalized dict.
+
+    Returns None when the config cannot be represented.
+    """
+
+    if not uri:
+        return None
+
+    uri = uri.strip()
+
+    lower = uri.lower()
+
+    try:
+
+        if lower.startswith("vless://"):
+            node = parse_vless(uri)
+
+        elif lower.startswith("vmess://"):
+            node = parse_vmess(uri)
+
+        elif lower.startswith("trojan://"):
+            node = parse_trojan(uri)
+
+        elif (
+            lower.startswith("ss://")
+            or lower.startswith("shadowsocks://")
+        ):
+            node = parse_shadowsocks(uri)
+
+        else:
+            return None
+
+    except Exception:
+
+        return None
+
+    if not node:
+        return None
+
+    # Attach the display name from the fragment when present.
+    if "#" in uri:
+
+        fragment = uri.split("#", 1)[1]
+
+        name = urllib.parse.unquote(fragment).strip()
+
+        if name:
+            node["name"] = name
+
+    node.setdefault("name", "")
+
+    return node
+
+
+# ============================================================
+# CLASH META (MIHOMO)
+# ============================================================
+
+# Ciphers Clash Meta accepts for Shadowsocks. Anything else
+# would make the whole profile fail to load, so those nodes
+# are dropped from the Clash output only.
+CLASH_SS_CIPHERS = {
+    "aes-128-gcm",
+    "aes-192-gcm",
+    "aes-256-gcm",
+    "aes-128-cfb",
+    "aes-192-cfb",
+    "aes-256-cfb",
+    "aes-128-ctr",
+    "aes-192-ctr",
+    "aes-256-ctr",
+    "rc4-md5",
+    "chacha20-ietf",
+    "xchacha20",
+    "chacha20-ietf-poly1305",
+    "xchacha20-ietf-poly1305",
+    "2022-blake3-aes-128-gcm",
+    "2022-blake3-aes-256-gcm",
+    "2022-blake3-chacha20-poly1305",
+}
+
+# Transports Clash Meta can express.
+CLASH_NETWORKS = {
+    "tcp",
+    "ws",
+    "grpc",
+    "http",
+}
+
+
+def _clash_transport(node, proxy):
+    """
+    Fill in the transport specific keys of a Clash proxy.
+    """
+
+    network = node.get("network", "tcp")
+
+    if network == "ws":
+
+        ws_opts = {
+            "path": node.get("path") or "/",
+        }
+
+        host = node.get("host") or node.get("sni")
+
+        if host:
+
+            ws_opts["headers"] = {
+                "Host": host,
+            }
+
+        proxy["ws-opts"] = ws_opts
+
+    elif network == "grpc":
+
+        proxy["grpc-opts"] = {
+            "grpc-service-name": (
+                node.get("service_name")
+                or node.get("path")
+                or ""
+            ),
+        }
+
+    elif network == "http":
+
+        http_opts = {
+            "path": [
+                node.get("path") or "/",
+            ],
+        }
+
+        host = node.get("host")
+
+        if host:
+
+            http_opts["headers"] = {
+                "Host": [host],
+            }
+
+        proxy["http-opts"] = http_opts
+
+
+def to_clash_proxy(node, name):
+    """
+    Convert a normalized node into a Clash Meta proxy dict.
+
+    Returns None when Clash cannot represent the node.
+    """
+
+    if not node:
+        return None
+
+    protocol = node.get("protocol")
+
+    network = node.get("network", "tcp")
+
+    if protocol != "shadowsocks":
+
+        if network not in CLASH_NETWORKS:
+            return None
+
+    proxy = {
+        "name": name,
+        "server": node["server"],
+        "port": node["port"],
+    }
+
+    security = node.get("security", "none")
+
+    tls_on = security in ("tls", "reality")
+
+    if protocol == "vless":
+
+        # Clash Meta cannot express every xhttp variant.
+        proxy.update({
+            "type": "vless",
+            "uuid": node["uuid"],
+            "udp": True,
+            "tls": tls_on,
+            "network": network,
+        })
+
+        if node.get("flow"):
+            proxy["flow"] = node["flow"]
+
+        if node.get("sni"):
+            proxy["servername"] = node["sni"]
+
+        if node.get("fingerprint"):
+            proxy["client-fingerprint"] = node["fingerprint"]
+
+        if node.get("insecure"):
+            proxy["skip-cert-verify"] = True
+
+        if security == "reality":
+
+            if not node.get("public_key"):
+                return None
+
+            proxy["reality-opts"] = {
+                "public-key": node["public_key"],
+            }
+
+            if node.get("short_id"):
+                proxy["reality-opts"]["short-id"] = (
+                    node["short_id"]
+                )
+
+        _clash_transport(node, proxy)
+
+    elif protocol == "vmess":
+
+        proxy.update({
+            "type": "vmess",
+            "uuid": node["uuid"],
+            "alterId": node.get("alter_id", 0),
+            "cipher": node.get("cipher") or "auto",
+            "udp": True,
+            "tls": tls_on,
+            "network": network,
+        })
+
+        if node.get("sni"):
+            proxy["servername"] = node["sni"]
+
+        if node.get("insecure"):
+            proxy["skip-cert-verify"] = True
+
+        _clash_transport(node, proxy)
+
+    elif protocol == "trojan":
+
+        proxy.update({
+            "type": "trojan",
+            "password": node["password"],
+            "udp": True,
+        })
+
+        if node.get("sni"):
+            proxy["sni"] = node["sni"]
+
+        if node.get("insecure"):
+            proxy["skip-cert-verify"] = True
+
+        if security == "reality":
+            # Clash Meta has no reality support for trojan.
+            return None
+
+        if network in ("ws", "grpc"):
+
+            proxy["network"] = network
+
+            _clash_transport(node, proxy)
+
+    elif protocol == "shadowsocks":
+
+        cipher = node.get("method", "").lower()
+
+        if cipher not in CLASH_SS_CIPHERS:
+            return None
+
+        if node.get("plugin"):
+            return None
+
+        proxy.update({
+            "type": "ss",
+            "cipher": cipher,
+            "password": node["password"],
+            "udp": True,
+        })
+
+    else:
+
+        return None
+
+    return proxy
+
+
+# ============================================================
+# SING-BOX
+# ============================================================
+
+# Transports sing-box can express.
+SINGBOX_NETWORKS = {
+    "tcp",
+    "ws",
+    "grpc",
+    "http",
+}
+
+
+def _singbox_tls(node):
+    """
+    Build the sing-box tls block for a node.
+    """
+
+    security = node.get("security", "none")
+
+    if security not in ("tls", "reality"):
+        return None
+
+    tls = {
+        "enabled": True,
+    }
+
+    server_name = node.get("sni") or node.get("host")
+
+    if server_name:
+        tls["server_name"] = server_name
+
+    if node.get("insecure"):
+        tls["insecure"] = True
+
+    alpn = node.get("alpn")
+
+    if alpn:
+
+        tls["alpn"] = [
+            item.strip()
+            for item in alpn.split(",")
+            if item.strip()
+        ]
+
+    fingerprint = node.get("fingerprint")
+
+    if fingerprint:
+
+        tls["utls"] = {
+            "enabled": True,
+            "fingerprint": fingerprint,
+        }
+
+    if security == "reality":
+
+        if not node.get("public_key"):
+            return None
+
+        reality = {
+            "enabled": True,
+            "public_key": node["public_key"],
+        }
+
+        if node.get("short_id"):
+            reality["short_id"] = node["short_id"]
+
+        tls["reality"] = reality
+
+        # Reality always requires uTLS.
+        tls.setdefault(
+            "utls",
+            {
+                "enabled": True,
+                "fingerprint": "chrome",
+            }
+        )
+
+    return tls
+
+
+def _singbox_transport(node):
+    """
+    Build the sing-box transport block for a node.
+    """
+
+    network = node.get("network", "tcp")
+
+    if network == "ws":
+
+        transport = {
+            "type": "ws",
+            "path": node.get("path") or "/",
+        }
+
+        host = node.get("host") or node.get("sni")
+
+        if host:
+
+            transport["headers"] = {
+                "Host": host,
+            }
+
+        return transport
+
+    if network == "grpc":
+
+        return {
+            "type": "grpc",
+            "service_name": (
+                node.get("service_name")
+                or node.get("path")
+                or ""
+            ),
+        }
+
+    if network == "http":
+
+        transport = {
+            "type": "http",
+            "path": node.get("path") or "/",
+        }
+
+        host = node.get("host")
+
+        if host:
+            transport["host"] = [host]
+
+        return transport
+
+    return None
+
+
+def to_singbox_outbound(node, tag):
+    """
+    Convert a normalized node into a sing-box outbound dict.
+
+    Returns None when sing-box cannot represent the node.
+    """
+
+    if not node:
+        return None
+
+    protocol = node.get("protocol")
+
+    network = node.get("network", "tcp")
+
+    if protocol != "shadowsocks":
+
+        if network not in SINGBOX_NETWORKS:
+            return None
+
+    outbound = {
+        "tag": tag,
+        "server": node["server"],
+        "server_port": node["port"],
+    }
+
+    if protocol == "vless":
+
+        outbound["type"] = "vless"
+        outbound["uuid"] = node["uuid"]
+
+        if node.get("flow"):
+            outbound["flow"] = node["flow"]
+
+    elif protocol == "vmess":
+
+        outbound["type"] = "vmess"
+        outbound["uuid"] = node["uuid"]
+        outbound["alter_id"] = node.get("alter_id", 0)
+        outbound["security"] = node.get("cipher") or "auto"
+
+    elif protocol == "trojan":
+
+        outbound["type"] = "trojan"
+        outbound["password"] = node["password"]
+
+    elif protocol == "shadowsocks":
+
+        if node.get("plugin"):
+            return None
+
+        outbound["type"] = "shadowsocks"
+        outbound["method"] = node["method"]
+        outbound["password"] = node["password"]
+
+        return outbound
+
+    else:
+
+        return None
+
+    tls = _singbox_tls(node)
+
+    if tls:
+        outbound["tls"] = tls
+
+    transport = _singbox_transport(node)
+
+    if transport:
+        outbound["transport"] = transport
+
+    return outbound
+
+
+# ============================================================
+# MINIMAL YAML WRITER
+# ============================================================
+
+def _yaml_scalar(value):
+    """
+    Render a scalar as YAML.
+
+    Strings are always quoted so that passwords, paths and
+    names containing ':', '#' or emoji never break parsing.
+    """
+
+    if isinstance(value, bool):
+        return "true" if value else "false"
+
+    if isinstance(value, int):
+        return str(value)
+
+    text = str(value)
+
+    escaped = (
+        text
+        .replace("\\", "\\\\")
+        .replace('"', '\\"')
+        .replace("\n", "\\n")
+        .replace("\r", "")
+        .replace("\t", "\\t")
+    )
+
+    return f'"{escaped}"'
+
+
+def _yaml_block(data, indent):
+    """
+    Render a nested dict/list structure as YAML lines.
+    """
+
+    pad = " " * indent
+
+    lines = []
+
+    if isinstance(data, dict):
+
+        for key, value in data.items():
+
+            if isinstance(value, (dict, list)):
+
+                if not value:
+                    continue
+
+                lines.append(f"{pad}{key}:")
+
+                lines.extend(
+                    _yaml_block(
+                        value,
+                        indent + 2
+                    )
+                )
+
+            else:
+
+                lines.append(
+                    f"{pad}{key}: "
+                    f"{_yaml_scalar(value)}"
+                )
+
+    elif isinstance(data, list):
+
+        for item in data:
+
+            if isinstance(item, dict):
+
+                rendered = _yaml_block(item, indent + 2)
+
+                if not rendered:
+                    continue
+
+                first = rendered[0].lstrip()
+
+                lines.append(f"{pad}- {first}")
+
+                lines.extend(rendered[1:])
+
+            else:
+
+                lines.append(
+                    f"{pad}- {_yaml_scalar(item)}"
+                )
+
+    return lines
+
+
+def build_clash_yaml(
+    proxies,
+    profile_name="POPVPN"
+):
+    """
+    Build a complete Clash Meta configuration.
+
+    Includes a URL-test group so the client always picks the
+    lowest latency node automatically.
+    """
+
+    names = [
+        proxy["name"]
+        for proxy in proxies
+    ]
+
+    header = [
+        f"# {profile_name} — Clash Meta / Mihomo",
+        "# https://github.com/pouria08/popvpn",
+        "",
+        "mixed-port: 7890",
+        "allow-lan: false",
+        "mode: rule",
+        "log-level: info",
+        "external-controller: 127.0.0.1:9090",
+        "",
+        "dns:",
+        "  enable: true",
+        "  ipv6: false",
+        "  enhanced-mode: fake-ip",
+        "  fake-ip-range: 198.18.0.1/16",
+        "  nameserver:",
+        '    - "https://1.1.1.1/dns-query"',
+        '    - "https://8.8.8.8/dns-query"',
+        "",
+        "proxies:",
+    ]
+
+    lines = list(header)
+
+    lines.extend(
+        _yaml_block(proxies, 2)
+    )
+
+    groups = [
+        {
+            "name": f"{profile_name} — Auto",
+            "type": "url-test",
+            "url": "http://www.gstatic.com/generate_204",
+            "interval": 300,
+            "tolerance": 50,
+            "proxies": names,
+        },
+        {
+            "name": f"{profile_name} — Select",
+            "type": "select",
+            "proxies": (
+                [f"{profile_name} — Auto"] + names
+            ),
+        },
+    ]
+
+    lines.append("")
+    lines.append("proxy-groups:")
+
+    lines.extend(
+        _yaml_block(groups, 2)
+    )
+
+    lines.append("")
+    lines.append("rules:")
+    lines.append("  - GEOIP,private,DIRECT,no-resolve")
+    lines.append(
+        f"  - MATCH,{profile_name} — Select"
+    )
+    lines.append("")
+
+    return "\n".join(lines)
+
+
+def build_singbox_json(
+    outbounds,
+    profile_name="POPVPN"
+):
+    """
+    Build a complete sing-box configuration.
